# Dependencies
node_modules/
**/node_modules/

# Build output
dist/
**/dist/
*.tsbuildinfo
**/*.tsbuildinfo

# Environment (single root .env holds everything; Vite reads it via envDir: '..')
.env
.env.*
!.env.example

# Supabase CLI link state & dotfiles
supabase/.temp/
supabase/.branches/
supabase/.env.keys
supabase/.env.local
supabase/.env.*.local

# OS / editor
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/
*.sw?
.kiro

# Wrangler / Cloudflare Workers local state
.wrangler/
.dev.vars

# Generated coverage-triage artifacts (regenerate via scripts/src/oneoff/check-coverage.ts
# and build-coverage-queue.ts; hand-edited inputs stay tracked)
data/coverage/report.txt
data/coverage/queue.json
data/coverage/queue-summary.md
data/coverage/master-triage.md
data/coverage/top_coasters.txt
data/coverage/sweep.json
data/coverage/apply-log-*.md

# Worktrees (created via the workflow in AGENTS.md)
.worktrees/

# logo-lab pipeline intermediates (regenerated by compose.mjs)
scripts/src/oneoff/logo-lab/.tmp-*
/scripts/src/oneoff/logo-lab/.tmp-*
*.pbm
scripts/node_modules

# local logo iteration artifacts (keep svg source, ignore raster intermediates)
new-logo-base.png
modified-bw.png
modified.png

# Logs
*.log
npm-debug.log*