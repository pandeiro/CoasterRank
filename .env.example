# CoasterRank environment variables.
# Copy this file to `.env` (repo root) and fill in real values.
# `.env` is gitignored. Vite reads it via `envDir: '..'` from app/vite.config.ts.
#
# Exposure rules:
#   - Variables prefixed with VITE_ are bundled into the client SPA (public, RLS-protected).
#   - Variables WITHOUT the VITE_ prefix are NEVER exposed to the browser; they are only
#     used by the Supabase CLI, scripts, and Edge Functions. Keep them that way.

# --- Supabase CLI (migrations / deploy) ---
# Personal access token for the CoasterRank Supabase account.
# Generate at: https://supabase.com/dashboard/account/tokens
# The CLI reads this automatically and it overrides any global `supabase login`.
SUPABASE_ACCESS_TOKEN=

# The project ref of the CoasterRank Supabase project (shown in dashboard URL / `supabase link`).
PROJECT_REF=

# --- Supabase API (server / scripts) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# SECRET: bypasses Row-Level Security. Never expose in client code or with a VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string. For GitHub Actions (no IPv6) this MUST be the Session pooler (IPv4):
#   postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-us-west-2.pooler.supabase.com:5432/postgres
# (Dashboard → Database → Connect → Session pooler; region is us-west-2 for this project).
# The direct `db.<ref>.supabase.co:5432` host is IPv6-only and fails on GH runners.
SUPABASE_DB_URL=

# --- SPA (public, RLS-protected) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Netlify (SPA deploy via GitHub Actions) ---
# These are used by the scheduled deploy-netlify workflow (GitHub Actions).
# They must be set as GitHub repo secrets — the workflow cannot read from .env.
NETLIFY_AUTH_TOKEN=
NETLIFY_SITE_ID=

# --- GitHub (database backup via GitHub Actions) ---
# Used by the backup-database workflow to push to CoasterRankBackups repo.
# Generate at: https://github.com/settings/tokens (classic, scope: repo)
BACKUP_PAT=

# --- Telegram (backup notifications via GitHub Actions) ---
# Used by the backup-database workflow to send success/failure notifications.
COASTER_RANK_ALERTS_BOT_TOKEN=
COASTER_RANK_EVENTS_BOT_TOKEN=
TELEGRAM_USER_ID=

# --- Edge Function (recompute-rankings) ---
# Shared secret used to authorize the pg_cron -> Edge Function HTTP call.
RECOMPUTE_AUTH_SECRET=