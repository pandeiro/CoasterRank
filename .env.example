# CoasterRank environment variables.
# Copy this file to `.env` (repo root) and fill in real values.
# `.env` is gitignored. Vite reads it via `envDir: '..'` from app/vite.config.ts.
#
# Exposure rules:
#   - Variables prefixed with VITE_ are bundled into the client SPA (public, RLS-protected).
#   - Variables WITHOUT the VITE_ prefix are NEVER exposed to the browser; they are only
#     used by the Supabase CLI, scripts, and Edge Functions. Keep them that way.

# --- Supabase CLI (migrations / deploy) ---
# Personal access token for the CoasterRank Supabase account.
# Generate at: https://supabase.com/dashboard/account/tokens
# The CLI reads this automatically and it overrides any global `supabase login`.
SUPABASE_ACCESS_TOKEN=

# The project ref of the CoasterRank Supabase project (shown in dashboard URL / `supabase link`).
PROJECT_REF=

# --- Supabase API (server / scripts) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# SECRET: bypasses Row-Level Security. Never expose in client code or with a VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string. For GitHub Actions (no IPv6) this MUST be the Session pooler (IPv4):
#   postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-us-west-2.pooler.supabase.com:5432/postgres
# (Dashboard → Database → Connect → Session pooler; region is us-west-2 for this project).
# The direct `db.<ref>.supabase.co:5432` host is IPv6-only and fails on GH runners.
SUPABASE_DB_URL=

# --- SPA (public, RLS-protected) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Sentry Frontend Observability ---
# VITE_ prefix means this is bundled into the browser app (public).
VITE_SENTRY_DSN=

# These MUST NEVER have a VITE_ prefix. They are used by the Vite build plugin
# (app/vite.config.ts) to generate hidden sourcemaps and upload them to Sentry.
# They MUST be set in BOTH places:
#   1) Local .env  → `npm run build` locally uploads maps while testing.
#   2) Cloudflare Workers dashboard → Settings → Variables & Secrets → Build
#      variables (SENTRY_AUTH_TOKEN as a secret, SENTRY_ORG / SENTRY_PROJECT as
#      plain vars) plus VITE_SENTRY_DSN. Workers auto-deploy (git → Cloudflare)
#      runs `npm run build` on Cloudflare's builder; without these vars the
#      build emits NO sourcemaps and skips sentryVitePlugin — Sentry will show
#      minified stacktraces with no source context. The vite config now warns
#      loudly ([sentry] Source-map upload DISABLED) when they are missing.
#   Set them via wrangler from .env:
#     source .env && echo "$SENTRY_AUTH_TOKEN" | npx wrangler secret put SENTRY_AUTH_TOKEN --config app/wrangler.toml
#     echo "$SENTRY_ORG"       | npx wrangler secret put SENTRY_ORG --config app/wrangler.toml
#     echo "$SENTRY_PROJECT"   | npx wrangler secret put SENTRY_PROJECT --config app/wrangler.toml
#     echo "$VITE_SENTRY_DSN"  | npx wrangler secret put VITE_SENTRY_DSN --config app/wrangler.toml
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- Cloudflare Workers (SPA auto-deploy) ---
# Cloudflare Workers auto-deploys on push to main (Git → Cloudflare build → wrangler publish).
# Build-time vars (read during `npm run build` on Cloudflare's builder) and runtime
# vars/secrets (read by the deployed Worker at request time) are both configured
# in the same Cloudflare dashboard place: Workers → coasterrank → Settings → Variables & Secrets.
# Required:
#   - Build: VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY, VITE_SENTRY_DSN,
#            SENTRY_AUTH_TOKEN (as a secret), SENTRY_ORG, SENTRY_PROJECT
#   - Runtime (Worker fetch): SUPABASE_URL, SUPABASE_ANON_KEY (or the VITE_ fallbacks)
# The vite config warns loudly if the SENTRY build vars are missing — without them
# the build emits NO sourcemaps and Sentry shows minified traces.

# --- GitHub (database backup via GitHub Actions) ---
# Used by the backup-database workflow to push to CoasterRankBackups repo.
# Generate at: https://github.com/settings/tokens (classic, scope: repo)
BACKUP_PAT=

# --- Telegram (backup notifications via GitHub Actions) ---
# Used by the backup-database workflow to send success/failure notifications.
COASTER_RANK_ALERTS_BOT_TOKEN=
COASTER_RANK_EVENTS_BOT_TOKEN=
TELEGRAM_USER_ID=

# --- Edge Function (recompute-rankings) ---
# Shared secret used to authorize the pg_cron -> Edge Function HTTP call.
RECOMPUTE_AUTH_SECRET=

# Edge Function environment label, prefixed onto Telegram alert/event messages
# ('prod' when unset). Set via `supabase secrets set APP_ENV=prod` (or
# =staging on a clone). Dispatch control for clones: simply do NOT set the
# Telegram token secrets on non-prod projects — sends no-op silently.
APP_ENV=

# Telegram bot tokens for Edge Function alerts/events (set via `supabase secrets set`).
# Same bots as the GitHub Actions backup workflow — reuse those tokens here.
COASTER_RANK_ALERTS_BOT_TOKEN=
COASTER_RANK_EVENTS_BOT_TOKEN=
TELEGRAM_USER_ID=