{
  "name": "coasterrank-scripts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Data-engineering scripts for CoasterRank (CSV imports, ops, maintenance). Runs against prod Supabase via SUPABASE_DB_URL / service-role. Separate from the SPA in app/.",
  "scripts": {
    "import-coasters": "tsx src/import-coasters.ts",
    "normalize-names": "tsx src/normalize-names.ts",
    "backfill-park-locations": "tsx src/backfill-park-locations.ts",
    "fix-missing-regions-and-non-english": "tsx src/fix-missing-regions-and-non-english.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.3",
    "commander": "^13.1.0",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.4.7",
    "openai": "7.5.0",
    "pg": "^8.13.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@vitest/coverage-v8": "4.1.11",
    "fast-check": "4.9.0",
    "prettier": "^3.9.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "4.1.11"
  }
}
